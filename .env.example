# =========================================================
# Personal Gemini Journal - Environment Configuration
# =========================================================

# --- Google Gemini AI Configuration (Server-Side Only) ---
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended models: gemini-2.5-flash, gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Client Configuration (Frontend Safe) ---
# Create a Firebase project at: https://console.firebase.google.com/
# Add a Web App in Project Settings to find these values:
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
